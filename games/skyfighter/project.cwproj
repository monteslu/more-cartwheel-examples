; skyfighter's release builds: node <host sdk>/tools/cwexport.mjs --project games/skyfighter --preset <preset>
name = "skyfighter"
app = "skyfighter"
app_id = "org.cartwheel.skyfighter"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "An arcade jet combat game with eight missions. Shoot balloons over farmland, clear interceptors off a coastal island, raid offshore oil rigs and bring down a giant mothership above a city."
author = "Luis Montes"
