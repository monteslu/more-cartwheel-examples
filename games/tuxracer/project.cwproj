name = Tux Racer
app = tuxracer
sources = src
render.width = 960
render.height = 540
render.vsync = true
render.msaa = 0
input.left = key:left, key:j, pad:left, axis:lx-, deadzone:0.18
input.right = key:right, key:l, pad:right, axis:lx+, deadzone:0.18
input.paddle = key:up, key:i, pad:up, pad:south, axis:ly-@0.4, deadzone:0.4
input.brake = key:down, key:k, pad:down, pad:east, axis:ly+@0.4, deadzone:0.4
input.jump = key:e, pad:west
input.reset = key:backspace, pad:back
input.quit_race = key:q
input.view = key:1, pad:lshoulder
input.view2 = key:2, pad:rshoulder
input.pause = key:escape, pad:start
input.menu_up = key:up, key:w, key:i, pad:up, axis:ly-@0.5, deadzone:0.5
input.menu_down = key:down, key:s, key:k, pad:down, axis:ly+@0.5, deadzone:0.5
input.menu_left = key:left, key:a, key:j, pad:left, axis:lx-@0.5, deadzone:0.5
input.menu_right = key:right, key:d, key:l, pad:right, axis:lx+@0.5, deadzone:0.5
input.menu_accept = key:return, key:space, key:e, pad:south, pad:start
input.menu_back = key:escape, key:backspace, pad:east, pad:back
version = 0.1.0
app_id = org.cartwheel.tuxracer
; release builds: node <host sdk>/tools/cwexport.mjs --project games/tuxracer --preset <preset>
export.linux-x64.platform = linux-x64
export.linux-arm64.platform = linux-arm64
export.windows-x64.platform = windows-x64
export.macos-arm64.platform = macos
export.android-arm64.platform = android-arm64
