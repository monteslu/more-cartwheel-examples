name = Party Pack
app = partypack
main_scene = scenes/hub.cwscene
version = 0.1.0
game_app = partypack
input.move_left = key:a, key:left, pad:left, axis:lx-
input.move_right = key:d, key:right, pad:right, axis:lx+
input.move_up = key:w, key:up, pad:up, axis:ly-
input.move_down = key:s, key:down, pad:down, axis:ly+
input.btn_a = key:space, key:return, pad:south
input.ui_start = pad:start
input.btn_b = key:lshift, key:rshift, pad:east
input.btn_x = key:z, pad:west
input.btn_y = key:x, pad:north
layer_names_3d = "world, player, pickup"
gravity_3d = vec3(0, -14, 0)
substeps = 4
render.width = 1280
render.height = 720
render.msaa = 4
render.vsync = true
