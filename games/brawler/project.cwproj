; export presets (node <host sdk>/tools/cwexport.mjs --project games/brawler --preset <preset>)
name = "Street Toughs"
app = "brawler"
title = "Street Toughs"
app_id = "org.cartwheel.brawler"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "Up to four friends fight side by side through an alley, the docks, an arcade and a roof, smashing crates, grabbing weapons and facing a boss at the end of each stage."
author = "Luis Montes"
