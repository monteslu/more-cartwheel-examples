# The game's settings (cartwheel/project.h) and its export presets (cwexport).
name = Arena
app = arenafps
version = 0.1.0
app_id = org.cartwheel.arenafps
# gameplay actions; the menus' (ui_*, pause) come from the engine's shell
input.move_left = key:a, pad:left, axis:lx-
input.move_right = key:d, pad:right, axis:lx+
input.move_forward = key:w, pad:up, axis:ly-
input.move_back = key:s, pad:down, axis:ly+
input.look_left = key:left, axis:rx-
input.look_right = key:right, axis:rx+
input.look_up = key:up, axis:ry-
input.look_down = key:down, axis:ry+
input.fire = key:j, mouse:left, axis:rt+@0.4, pad:rshoulder
input.jump = key:space, pad:south
input.weapon_next = key:e, pad:north
input.weapon_prev = key:q, pad:west
input.sprint = key:lshift, pad:lstick
input.ui_start = key:return, pad:start
layer_names_3d = "world, fighters"
render.width = 960
render.height = 540
render.msaa = 4
render.vsync = true
export.linux-x64.platform = linux-x64
export.linux-arm64.platform = linux-arm64
export.windows-x64.platform = windows-x64
export.macos-arm64.platform = macos
export.android-arm64.platform = android-arm64
