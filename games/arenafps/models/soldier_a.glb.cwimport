# the motion: clips of the Universal Animation Library 1 and 2 (Quaternius, CC0; tools/blender/anims.py picks, joins,
# times and makes them into anim/ual.glb on the same rig as this soldier), baked onto this soldier's skeleton when the
# cart is packed (cartwheel's retargeting), the walks' planted feet held still (the sprint's capture plants its own
# feet at an even speed already; the packer's pass, which finds the stance from the ankle, breaks its three-frame stance).
retarget.source = anim/ual.glb
retarget.fps = 30
retarget.plant = walk_f walk_fl walk_fr walk_l walk_r walk_b walk_bl walk_br walk_bl90 walk_br90
# coarser index buffers for soldiers far off (cw_gltf_instance_auto_lod picks one by its error on screen)
mesh.lods = 0.5 0.25 0.12
