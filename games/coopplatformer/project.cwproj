; coopplatformer's release builds: node <host sdk>/tools/cwexport.mjs --project games/coopplatformer --preset <preset>
name = "coopplatformer"
app = "coopplatformer"
version = "0.1.0"
app_id = "org.cartwheel.coopplatformer"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "A co-op platformer for one to four players on one shared screen, across a meadow, torchlit caves, a flooded ruin and a volcano, opening the way with an air jump, wall claws and a dash."
author = "Luis Montes"
