   for (int i = 0; i < G.nf; i++) {
     fighter *f = F(i);
     if (!f->active) continue;
diff --git a/games/arenafps/src/motionrec.c b/games/arenafps/src/motionrec.c
new file mode 100644
index 0000000..1e9b1c8
--- /dev/null
+++ b/games/arenafps/src/motionrec.c
@@ -0,0 +1,125 @@
+/* arenafps (the control for tests/arenafps-motion.mjs): the same motion recorder as soldier.c's, on the hand-keyed
+ * 15 bone rig and its three clips, so the motion test measures the build before the captured motion. The old rig's
+ * bones stand in for the new one's: hips for the pelvis, chest for spine_03, the forearms for the hands; the feet for
+ * the toes; the rifle's stock and muzzle are points rigid on the right forearm, where tools/blender/soldier.py put
+ * them (the bore along the model's -z at rest). */
+#include "game.h"
+#include "cartwheel/ik.h"
+
+struct t3_object *arena_rig_scene(int slot);
+static const char *const NB[] = { "pelvis", "foot_l", "foot_r", "ball_l", "ball_r", "spine_03", "Head", "hand_l", "hand_r", "rifle", "muzzle" };
+static const char *const OLD[] = { "hips", "foot_l", "foot_r", "foot_l", "foot_r", "chest", "head", "fore_l", "fore_r", "fore_r", "fore_r" };
+#define NBN 11
+#define RMAX 9600
+static const float ANKLE = 0.10f;
+typedef struct { int tick, slot, alive, floor, lod; float x, y, z, yaw, pitch, vx, vz, back; char clip[12]; float w, ground[2]; float p[NBN][3]; } row;
+typedef struct { int alive, floor; t3_vec3 pos, vel; float yaw, pitch; const char *clip; bool set; } st;
+static row *R;
+static int rn, rwant, rtick, ns, slots[4], bound_of[4] = { -1, -1, -1, -1 }, idx[4][NBN];
+static st prev[4];
+static cw_pose P[4];
+static t3_vec3 local_off[4][2];
+
+static t3_vec3 qrot(t3_quat q, t3_vec3 v) {
+  t3_vec3 u = { q.x, q.y, q.z }, t = v3scale(v3cross(u, v), 2);
+  return v3add(v3add(v, v3scale(t, q.w)), v3cross(u, t));
+}
+static t3_mat4 m2w(t3_vec3 at, float yaw) {
+  t3_mat4 m;
+  float s, c;
+  cw_sincos(yaw * 0.5f, &s, &c);
+  t3_mat4_compose(&m, at, (t3_quat){ 0, s, 0, c }, (t3_vec3){ 1, 1, 1 });
+  return m;
+}
+static void cmd(int argc, const char **argv, cw_reply *rp) {
+  if (argc >= 2 && !strcmp(argv[1], "rec")) {
+    rwant = argc >= 3 ? CW_CLAMP(atoi(argv[2]), 1, RMAX) : 600;
+    ns = 0;
+    for (int k = 3; k < argc && ns < 4; k++) slots[ns++] = CW_CLAMP(atoi(argv[k]), 0, MAXF - 1);
+    if (!ns) slots[ns++] = 0;
+    for (int k = 0; k < 4; k++) prev[k].set = false;
+    if (!R) R = (row *)calloc(RMAX, sizeof *R);
+    rn = 0;
+    cw_reply_printf(rp, "{\"recording\":%d,\"slots\":%d}", rwant, ns);
+    return;
+  }
+  if (argc >= 2 && !strcmp(argv[1], "info")) {
+    cw_reply_printf(rp, "{\"rows\":%d,\"want\":%d,\"ankle\":%.4f,\"bones\":[", rn, rwant, (double)ANKLE);
+    for (int b = 0; b < NBN; b++) cw_reply_printf(rp, "%s\"%s\"", b ? "," : "", NB[b]);
+    cw_reply_printf(rp, "]}");
+    return;
+  }
+  if (argc >= 4 && !strcmp(argv[1], "get")) {
+    int from = CW_CLAMP(atoi(argv[2]), 0, rn), n = CW_CLAMP(atoi(argv[3]), 0, rn - from);
+    cw_reply_printf(rp, "[");
+    for (int k = 0; k < n; k++) {
+      const row *w = &R[from + k];
+      cw_reply_printf(rp, "%s[%d,%d,%d,%d,%d,%.4f,%.4f,%.4f,%.5f,%.5f,%.4f,%.4f,%.3f,\"%s\",%.3f,%.4f,%.4f", k ? "," : "", w->tick, w->slot, w->alive, w->floor,
+                      w->lod, w->x, w->y, w->z, w->yaw, w->pitch, w->vx, w->vz, w->back, w->clip, w->w, w->ground[0], w->ground[1]);
+      for (int b = 0; b < NBN; b++) cw_reply_printf(rp, ",%.4f,%.4f,%.4f", w->p[b][0], w->p[b][1], w->p[b][2]);
+      cw_reply_printf(rp, "]");
+    }
+    cw_reply_printf(rp, "]");
+    return;
+  }
+  cw_reply_error(rp, "motion rec <ticks> [slot ...] | motion info | motion get <from> <n>");
+}
+
+void motionrec_tick(fighter *fs, int nf) {
+  static bool reg;
+  if (!reg) cw_debug_command("motion", "motion rec <ticks> [slot ...] | info | get <from> <n>: the motion recorder (control)", cmd), reg = true;
+  rtick++;
+  for (int s = 0; s < ns && R && rn < rwant; s++) {
+    int slot = slots[s];
+    t3_object *sc = arena_rig_scene(slot);
+    if (!sc || !prev[s].set) continue;
+    if (bound_of[s] != slot) {
+      if (bound_of[s] >= 0) cw_pose_free(&P[s]);
+      bound_of[s] = -1;
+      if (!cw_pose_bind(&P[s], sc)) continue;
+      bound_of[s] = slot;
+      for (int k = 0; k < NBN; k++) idx[s][k] = cw_pose_find(&P[s], OLD[k]);
+      /* the rifle's stock and muzzle in the right forearm's frame, from the rest pose (a fresh copy of the model) */
+      size_t len = 0;
+      void *bytes = cw_asset_load("models/soldier_a.glb", &len);
+      t3_gltf *gl = bytes ? t3_gltf_parse(bytes, len, NULL, NULL) : NULL;
+      cw_pose rp = { 0 };
+      if (!gl || !cw_pose_bind(&rp, gl->scene)) continue;
+      cw_pose_update_model(&rp);
+      int fr = cw_pose_find(&rp, "fore_r");
+      t3_vec3 pr = cw_pose_model_position(&rp, fr);
+      t3_quat qr = cw_pose_model_rotation(&rp, fr), qi = { -qr.x, -qr.y, -qr.z, qr.w };
+      cw_pose_free(&rp);
+      t3_release(gl);
+      free(bytes);
+      const t3_vec3 stock = { -0.04f, 1.365f, 0.0f }, muzzle = { -0.04f, 1.365f, -0.97f };
+      local_off[s][0] = qrot(qi, v3sub(stock, pr));
+      local_off[s][1] = qrot(qi, v3sub(muzzle, pr));
+    }
+    cw_pose_capture(&P[s]);
+    cw_pose_update_model(&P[s]);
+    const st *m = &prev[s];
+    row *w = &R[rn++];
+    w->tick = rtick, w->slot = slot, w->alive = m->alive, w->floor = m->floor, w->lod = 0;
+    w->x = m->pos.x, w->y = m->pos.y, w->z = m->pos.z, w->yaw = m->yaw, w->pitch = m->pitch, w->vx = m->vel.x, w->vz = m->vel.z, w->back = 0;
+    snprintf(w->clip, sizeof w->clip, "%s", m->clip ? m->clip : "");
+    w->w = 1;
+    t3_mat4 mw = m2w(m->pos, m->yaw);
+    for (int k = 0; k < NBN; k++) {
+      t3_vec3 p = idx[s][k] >= 0 ? cw_pose_model_position(&P[s], idx[s][k]) : (t3_vec3){ 0 };
+      if (k >= 9) p = v3add(p, qrot(cw_pose_model_rotation(&P[s], idx[s][k]), local_off[s][k - 9]));
+      t3_vec3 q = t3_vec3_apply_mat4(p, &mw);
+      w->p[k][0] = q.x, w->p[k][1] = q.y, w->p[k][2] = q.z;
+    }
+    for (int k = 0; k < 2; k++) {
+      t3_vec3 a = { w->p[1 + k][0], w->p[1 + k][1], w->p[1 + k][2] }, hp;
+      w->ground[k] = arena_ray(v3add(a, v3(0, 0.6f, 0)), v3add(a, v3(0, -1.5f, 0)), &hp, NULL) ? hp.y : -1000.0f;
+    }
+  }
+  for (int s = 0; s < ns; s++) {
+    int slot = slots[s];
+    if (slot >= nf) continue;
+    const fighter *f = &fs[slot];
+    prev[s] = (st){ f->alive, f->mv.on_floor, f->mv.position, f->mv.velocity, f->yaw, f->pitch, f->clip, true };
+  }
+}
