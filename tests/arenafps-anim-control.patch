diff --git a/games/arenafps/src/crowd_old.c b/games/arenafps/src/crowd_old.c
new file mode 100644
index 0000000..e1a9ee6
--- /dev/null
+++ b/games/arenafps/src/crowd_old.c
@@ -0,0 +1,73 @@
+/* arenafps (the build before, for tests/arenafps-anim-cost.mjs): ARENA_CROWD=n soldiers as this build draws its
+ * fighters (each body its own parsed glTF, an AnimationPlayer playing idle or run with the old speed rule), running
+ * the same circles round the spawn points as soldier.c's bench crowd, so the two builds' cost per soldier compare. */
+#include "game.h"
+#include "cartwheel/anim.h"
+
+#define CROWD_MAX 48
+static struct { cw_node body, anim; t3_gltf *gl; t3_vec3 c; float r, w, phase; int face; const char *clip; } CR[CROWD_MAX];
+static int crowd_n, crowd_t;
+static void *bytes[2];
+static size_t len[2];
+static void cast(t3_object *o) {
+  if (o->type == T3_SKINNED_MESH || o->type == T3_MESH) o->cast_shadow = true, o->receive_shadow = true, o->frustum_culled = false;
+  for (int i = 0; i < o->child_count; i++) cast(o->children[i]);
+}
+void crowd_old_make(int n, cw_node world, const t3_vec3 *centres, int ncentres) {
+  crowd_n = CW_CLAMP(n, 0, CROWD_MAX);
+  for (int k = 0; k < crowd_n && ncentres > 0; k++) {
+    int v = k & 1;
+    if (!bytes[v]) bytes[v] = cw_asset_load(v ? "models/soldier_b.glb" : "models/soldier_a.glb", &len[v]);
+    CR[k].body = cw_node_new("Node3D", "Body");
+    cw_node model = cw_node_new("Node3D", "Model");
+    CR[k].anim = cw_node_new("AnimationPlayer", "Anim");
+    cw_node_add_child(CR[k].body, model);
+    cw_node_add_child(CR[k].body, CR[k].anim);
+    cw_node_add_child(world, CR[k].body);
+    t3_gltf *gl = t3_gltf_parse(bytes[v], len[v], NULL, NULL);
+    CR[k].gl = gl;
+    if (gl) {
+      cw_node3d_set_object(model, gl->scene);
+      cast(gl->scene);
+      for (int i = 0; i < gl->animation_count; i++) {
+        cw_anim a = cw_anim_from_t3_clip(gl->animations[i], "Model");
+        cw_anim_set_stored(a, false);
+        cw_anim_set_loop(a, gl->animations[i]->name && gl->animations[i]->name[0] == 'd' ? CW_LOOP_NONE : CW_LOOP_LINEAR);
+        cw_anim_player_add(CR[k].anim, gl->animations[i]->name, a);
+        cw_anim_release(a);
+      }
+      cw_anim_player_play(CR[k].anim, "idle", 0);
+    }
+    CR[k].clip = "idle";
+    CR[k].c = centres[k % ncentres];
+    CR[k].r = 3.0f + (float)(k % 3);
+    CR[k].w = (k % 4 == 3) ? 0 : (k % 4 == 2 ? 0.45f : 1.4f) * (k & 1 ? 1 : -1);
+    CR[k].phase = (float)k * 1.7f;
+    CR[k].face = k % 3;
+  }
+}
+void crowd_old_tick(void) {
+  crowd_t++;
+  for (int k = 0; k < crowd_n; k++) {
+    if (!CR[k].gl) continue;
+    float a = CR[k].phase + CR[k].w * (float)crowd_t * TICK_DT, sa, ca;
+    cw_sincos(a, &sa, &ca);
+    t3_vec3 p = v3add(CR[k].c, v3(ca * CR[k].r, 0, sa * CR[k].r)), hp;
+    if (arena_ray(v3add(p, v3(0, 2, 0)), v3add(p, v3(0, -4, 0)), &hp, NULL)) p.y = hp.y;
+    t3_vec3 vel = v3scale(v3(-sa, 0, ca), CR[k].w * CR[k].r);
+    float yaw = CR[k].face == 0 ? cw_atan2(-vel.x, -vel.z) : CR[k].face == 1 ? cw_atan2(ca, sa) : cw_atan2(-ca, -sa);
+    if (CR[k].w == 0) yaw = a;
+    float sy, cy;
+    cw_sincos(yaw * 0.5f, &sy, &cy);
+    cw_node3d_set_position(CR[k].body, p);
+    cw_node3d_set_quaternion(CR[k].body, (t3_quat){ 0, sy, 0, cy });
+    float spd = v3len(vel);
+    const char *want = spd > 1.2f ? "run" : "idle";
+    if (want != CR[k].clip) CR[k].clip = want, cw_anim_player_play(CR[k].anim, want, 0.15f);
+    cw_node_set(CR[k].anim, "speed_scale", cw_val_float(want[0] == 'r' ? CW_CLAMP(spd / 6.0f, 0.6f, 1.5f) : 1.0f));
+  }
+}
+void crowd_old_free(void) {
+  for (int k = 0; k < crowd_n; k++) if (CR[k].gl) t3_release(CR[k].gl), CR[k].gl = NULL;
+  crowd_n = 0;
+}
